# Frontend data source mode.
# mock: frontend-only demo with static data + localStorage overlay.
# api: FastAPI + PostgreSQL read/write mode.
#
# Change this value to "api" when using the backend.
# Restart the Vite dev server after changing Vite env values.
VITE_DATA_SOURCE=mock

# Used by API mode.
# The host here must match the host you open the app at (use localhost for both:
# open http://localhost:5173). Otherwise the server-side session cookie
# (SameSite=Lax) is treated as cross-site, gets dropped, and login bounces back
# to the login screen.
VITE_API_BASE_URL=http://localhost:8000

# Serving the app to the company network from a shared PC/VM: put that host's
# IP here (this URL is called by each visitor's browser, not by the server), run
# the dev server with `npm run dev:lan`, and open the app at
# http://<SERVING_IP>:5173 — never localhost, per the note above. The backend
# needs matching CORS_ALLOW_ORIGINS / ASSET_PROXY_BASE_URL values.
# See docs/QUICK_RUN_GUIDE_COMPANY.md.
# VITE_API_BASE_URL=http://10.10.20.30:8000
