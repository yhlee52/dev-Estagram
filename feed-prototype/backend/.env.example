APP_NAME=feed-prototype-backend
APP_ENV=local

# Local PostgreSQL database used by FastAPI, Alembic, seed, and import scripts.
# Confirm this target before running external imports.
# Do not put a real production DB URL or secret in this example file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/feed_dev

# Optional shared-token protection for POST /api/imports (v0.3.0).
# Leave unset for local use (no check). When set, requests must send a matching
# X-Import-Token header. This is not real auth (auth is v0.6.x).
# IMPORT_API_TOKEN=change-me

# Optional override for the external_posts working tree (v0.3.2). The directory
# batch processor (process_incoming) derives incoming/archive/failed from this.
# Defaults to the repo's feed-prototype/data/external_posts.
# EXTERNAL_POSTS_DIR=/abs/path/to/data/external_posts

# Session cookie / CORS hardening (v1.0.0). Both default to the localhost dev
# posture below and only need to be set for a non-localhost deployment.
# Set true only when the backend is served over HTTPS (a non-secure cookie
# won't be sent back by the browser on a secure-required setup, and a secure
# cookie won't be sent over plain HTTP).
# SESSION_COOKIE_SECURE=false
# Comma-separated list of exact scheme+host+port origins allowed to send
# credentialed requests (cookies). Must match the deployed frontend's origin.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
