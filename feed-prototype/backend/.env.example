APP_ENV=local

# Local PostgreSQL used by FastAPI, migrations, seed and import tools.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/feed_dev

# One local root for incoming/, archive/, failed/ and copied assets/.
# Forward slashes work in Windows paths. Omit to use data/external_posts in repo.
# EXTERNAL_POSTS_DIR=C:/feed-data

# Disk imports copy relative-path assets under EXTERNAL_POSTS_DIR/assets by default.
# MANAGE_ASSET_STORAGE=true
# LOCAL_ASSET_BASE_URL=http://127.0.0.1:8000

# Optional: override the managed copy directory while retaining the same URL
# mapping. Keep it accessible to the backend process.
# MANAGED_ASSETS_DIR=C:/feed-data/assets

# Local browser access and session cookie settings.
# SESSION_COOKIE_SECURE=false
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared token for POST /api/imports. File-based import needs no token.
# IMPORT_API_TOKEN=change-me
