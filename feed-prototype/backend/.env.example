APP_NAME=feed-prototype-backend
APP_ENV=local

# Local PostgreSQL database used by FastAPI, Alembic, seed, and import scripts.
# Confirm this target before running external imports.
# Do not put a real production DB URL or secret in this example file.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/feed_dev

# Optional shared-token protection for POST /api/imports (v0.3.0).
# Leave unset for local use (no check). When set, requests must send a matching
# X-Import-Token header. This is not real auth (auth is v0.6.x).
# IMPORT_API_TOKEN=change-me

# Optional override for the external_posts working tree (v0.3.2). The directory
# batch processor (process_incoming) derives incoming/archive/failed from this.
# Defaults to the repo's feed-prototype/data/external_posts.
# EXTERNAL_POSTS_DIR=/abs/path/to/data/external_posts

# Asset managed storage copy (v0.3.3, opt-in, defaults to false). When on,
# importing a package whose asset url is a relative local path copies the
# file into public/assets/managed/ and rewrites the DB url to
# /assets/managed/... Leave this off if your packages only use /assets/...
# or http(s):// urls; turn it on if you import packages with relative
# local asset paths, or images will silently fail to load (v1.0.1 hotfix).
# MANAGE_ASSET_STORAGE=true

# Session cookie / CORS hardening (v1.0.0). Both default to the localhost dev
# posture below and only need to be set for a non-localhost deployment.
# Set true only when the backend is served over HTTPS (a non-secure cookie
# won't be sent back by the browser on a secure-required setup, and a secure
# cookie won't be sent over plain HTTP).
# SESSION_COOKIE_SECURE=false
# Comma-separated list of exact scheme+host+port origins allowed to send
# credentialed requests (cookies). Must match the deployed frontend's origin.
# CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- LAN serving from a shared serving PC/VM ----------------------------------
# To let anyone on the company network reach the app at http://<SERVING_IP>:5173,
# three values here must name the serving host instead of localhost, and both
# processes must bind 0.0.0.0 (uvicorn --host 0.0.0.0 / npm run dev:lan):
#
#   ASSET_PROXY_BASE_URL=http://10.10.20.30:8000   # or every S3 asset 404s
#   CORS_ALLOW_ORIGINS=http://10.10.20.30:5173     # or every API call is blocked
#   SESSION_COOKIE_SECURE=false                    # plain HTTP on the LAN
#
# The session cookie is SameSite=Lax, so the browser only returns it when the
# page origin and the API origin are the same site. Open the app at the serving
# host's IP, NOT at localhost — a localhost:5173 page calling an IP-based API is
# cross-site, the cookie is dropped, and login bounces back to the login screen.
# Adding localhost to CORS_ALLOW_ORIGINS does not fix that (cookies != CORS).
# Full walkthrough: docs/QUICK_RUN_GUIDE_COMPANY.md

# --- External post ingestion backend (v1.2.0) ---------------------------------
# "filesystem" (default) keeps the existing incoming/ directory watch (v0.3.x).
# "s3" enables S3-compatible object-storage discovery. Both share the same
# importer; only discovery + asset access differ.
# INGEST_STORAGE_BACKEND=filesystem

# --- S3-compatible object storage (v1.2.0) ------------------------------------
# The same boto3 code targets local MinIO (home) and a company S3 endpoint; only
# these values change. NEVER commit real secrets — put them in .env (gitignored),
# keep only placeholders here.
#
# Home MinIO example:
#   INGEST_STORAGE_BACKEND=s3
#   S3_ENDPOINT_URL=http://localhost:9000
#   S3_ACCESS_KEY_ID=localadmin
#   S3_SECRET_ACCESS_KEY=localpassword
#   S3_REGION=us-east-1
#   S3_BUCKET=estagram
#   S3_ROOT_PREFIX=estagram
#   S3_FORCE_PATH_STYLE=true
#
# Company S3 example (on-prem S3-compatible storage on an internal domain). Set
# S3_ENDPOINT_URL to the endpoint your infra team gives you — host only, no
# bucket and no trailing slash — and keep path-style on, same as MinIO: with an
# internal-domain endpoint, virtual-hosted addressing would look up
# <bucket>.s3.company.internal, which internal DNS does not resolve. Leave
# S3_ENDPOINT_URL empty only for plain public AWS S3 (and set path-style false).
# S3_REGION is often nominal on these stores; use whatever the admin specifies,
# else us-east-1. If the endpoint uses an internal CA, point AWS_CA_BUNDLE at
# its .pem in every process's environment.
#   INGEST_STORAGE_BACKEND=s3
#   S3_ENDPOINT_URL=https://s3.company.internal
#   S3_ACCESS_KEY_ID=your-access-key
#   S3_SECRET_ACCESS_KEY=your-secret-key
#   S3_REGION=us-east-1
#   S3_BUCKET=company-estagram
#   S3_ROOT_PREFIX=estagram
#   S3_FORCE_PATH_STYLE=true
#
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=ap-northeast-2
# S3_BUCKET=
# S3_ROOT_PREFIX=estagram
# S3_FORCE_PATH_STYLE=false

# Object layout (defaults shown). Override only if your producer differs.
# S3_BATCHES_PREFIX=batches
# S3_MANIFEST_FILENAME=feed_posts.json
# S3_READY_FILENAME=_READY.json

# Absolute base URL the API prepends to the asset proxy URL for S3-backed assets
# (v1.2.4). Must be the backend's own externally reachable origin (the frontend
# uses the stored asset url directly, without prepending its API base). Defaults
# to the local dev backend; set for any non-localhost deployment.
# ASSET_PROXY_BASE_URL=http://127.0.0.1:8000

# Watch worker knobs (declared in v1.2.0, consumed by the worker in v1.2.2).
# S3_WATCH_ENABLED=false
# S3_WATCH_INTERVAL_SECONDS=10
# S3_WATCH_BATCH_LIMIT=20
# S3_PROCESSING_TIMEOUT_SECONDS=1800
# S3_FAILED_RETRY_ENABLED=false
# S3_FAILED_MAX_ATTEMPTS=3
