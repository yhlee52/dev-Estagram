# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local
.env
.env.local
*.env.local

# Python / backend
__pycache__/
*.py[cod]
backend/.env
backend/.env.local
backend/.venv/
backend/uploads/*
!backend/uploads/.gitkeep

# Local data generated by the folder watcher and managed asset copy.
data/external_posts/incoming/*
!data/external_posts/incoming/.gitkeep
data/external_posts/archive/*
!data/external_posts/archive/.gitkeep
data/external_posts/failed/*
!data/external_posts/failed/.gitkeep
data/external_posts/assets/

# Existing public asset folders may still contain manually generated files.
public/assets/managed/*
!public/assets/managed/.gitkeep

# Generated assets dropped by external/import + watch flows (runtime artifacts; keep dir, ignore contents)
public/assets/generated/*
!public/assets/generated/.gitkeep

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
