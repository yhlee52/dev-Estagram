# Managed asset storage copies (v0.3.3 opt-in runtime artifacts; keep dir, ignore contents)
public/assets/managed/*
!public/assets/managed/.gitkeep

# Generated assets dropped by external/import + watch flows (runtime artifacts; keep dir, ignore contents)
public/assets/generated/*
!public/assets/generated/.gitkeep

